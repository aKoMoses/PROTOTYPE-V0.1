{
  "description": "Coordination Prototype 0 : contexte compact, réservation avant écriture, interruption visible. Aucun prompt ni transcript envoyé.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "commandWindows": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "timeout": 8,
            "additionalContextLimit": 450,
            "statusMessage": "Consultation des développements partagés"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|shell|shell_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "commandWindows": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "timeout": 8,
            "additionalContextLimit": 250,
            "statusMessage": "Vérification de la réservation"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "commandWindows": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "commandWindows": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/tools/coordinate.cjs').runHook()\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
